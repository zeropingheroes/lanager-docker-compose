services:
    lanager:
        build:
            context: $PATH_TO_LANAGER_GIT_REPO
            dockerfile: Dockerfile
            target: dev
        entrypoint: php artisan octane:frankenphp --workers=1 --max-requests=1 # --log-level=debug
        volumes:
            - "$PATH_TO_LANAGER_GIT_REPO:/app"
            - "$PATH_TO_LANAGER_GIT_REPO/storage:/app/storage"
            - "$PATH_TO_LANAGER_GIT_REPO/.env:/app/.env"
            # - "./configs/app/lanager-php-xdebug.ini:/usr/local/etc/php/conf.d/lanager-php-xdebug.ini"
        environment:
            DUSK_DRIVER_URL: "http://selenium:4444/wd/hub"
        depends_on:
            - selenium
    db:
        ports:
            - "3306:3306"
    selenium:
        container_name: selenium
        image: 'selenium/standalone-chrome'
        volumes:
            - './selenium:/selenium'
        networks:
            - lanager-network
        ports:
            - "5900:5900"
        shm_size: '2gb'
