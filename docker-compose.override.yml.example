services:

    lanager:
        build:
            context: $PATH_TO_LANAGER
            dockerfile: Dockerfile
            target: dev
        volumes:
            - "$PATH_TO_LANAGER:/var/www/lanager"
            - "$PATH_TO_LANAGER_STORAGE:/var/www/lanager/storage"
            - "$PATH_TO_LANAGER_DOT_ENV_FILE:/var/www/lanager/.env"
            - "./configs/app/lanager-php-xdebug.ini:/etc/php83/conf.d/lanager-php-xdebug.ini"
        environment:
            DUSK_DRIVER_URL: "http://selenium:4444/wd/hub"
        depends_on:
            - selenium
    db:
        ports:
            - "3306:3306"
    selenium:
        container_name: selenium
        image: 'selenium/standalone-chrome'
        volumes:
            - './selenium:/selenium'
        networks:
            - lanager-network
        ports:
            - "5900:5900"
